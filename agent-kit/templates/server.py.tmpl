"""{{NAME}} - {{APP_TITLE}} MCP server (generated by agent-kit/new-agent.mjs).

Generic parts (JSON-RPC loop, project folders, path checks, process runner) are in ruxt_mcp_base.py.
Add the {{APP_TITLE}}-specific tools below with @server.tool(...).
Anything that runs generated code should install ruxt_script_guard first (see the Blender agent).
"""

import os
import shutil
from pathlib import Path

from ruxt_mcp_base import McpServer, Workspace

server = McpServer("{{SLUG}}-{{APP_ID}}", "0.1.0")
workspace = Workspace("{{APP_ID}}")


def find_app():
    """{{APP_TITLE}} executable on this PC, or None. Order matches app.detect in manifest.json."""
    env = os.environ.get("{{APP_ENV}}")
    if env and Path(env).is_file():
        return env
    found = shutil.which("{{APP_ID}}") or shutil.which("{{APP_ID}}.exe")
    if found:
        return found
    for var in ("ProgramFiles", "ProgramFiles(x86)", "LOCALAPPDATA"):
        root = os.environ.get(var)
        if not root or not Path(root).is_dir():
            continue
        for folder in sorted(Path(root).iterdir()):
            if "{{APP_ID}}" in folder.name.lower():
                for exe in folder.rglob("*.exe"):
                    if exe.stem.lower() == "{{APP_ID}}":
                        return str(exe)
    return None


@server.tool("app_status", "Check whether {{APP_TITLE}} is installed on this PC and where projects are stored.")
def app_status(_args):
    exe = find_app()
    return {"installed": exe is not None, "bin": exe, "projects_root": str(workspace.root)}


@server.tool("create_project", "Create a new project folder and return its project_id.",
             {"name": {"type": "string", "description": "Short human name"}})
def create_project(args):
    project_id, path = workspace.create_project(args.get("name"))
    return {"ok": True, "project_id": project_id, "dir": str(path)}


@server.tool("list_projects", "List existing projects.")
def list_projects(_args):
    return {"ok": True, "projects": workspace.list_projects()}


if __name__ == "__main__":
    server.serve()
