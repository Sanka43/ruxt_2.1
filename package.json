{
  "name": "ruxt-desktop",
  "version": "2.0.0",
  "description": "RuXt 2.1 - Zero-Config AI Agent Desktop Platform",
  "main": "electron/main.cjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sanka43/ruxt_2.1.git"
  },
  "scripts": {
    "dev": "concurrently \"cross-env ELECTRON_RUN_AS_NODE=1 electron server/index.js\" \"vite\"",
    "build": "vite build",
    "server": "cross-env ELECTRON_RUN_AS_NODE=1 electron server/index.js",
    "test:computer-use": "cross-env ELECTRON_RUN_AS_NODE=1 electron server/tests/computerUse.test.js",
    "electron:dev": "concurrently \"cross-env ELECTRON_RUN_AS_NODE=1 electron server/index.js\" \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "start": "cross-env ELECTRON_RUN_AS_NODE=1 electron server/index.js",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "dev.ruxt.desktop",
    "productName": "RuXt AI Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "Sanka43",
        "repo": "ruxt_2.1"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron/**/*",
      "server/**/*",
      "agents/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/server/services/*.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/ruxt-logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "public/ruxt-logo.png"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "lucide-react": "^0.474.0",
    "marked": "^18.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
